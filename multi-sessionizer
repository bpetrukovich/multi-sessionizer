#!/usr/bin/env bash

project_dirs_depth_1=(
  "$HOME/personal"
  "$HOME/personal/exercises/"
  "$HOME/itr"
  "$HOME/.microsoft/usersecrets/"
)

project_dirs_depth_2=(
  "$HOME/work"
)

extra_dirs=(
  "$HOME/obsidian-vault"
  "$HOME/.local/scripts"
  "$HOME/.local/share"
  "$HOME/.config/nvim"
  "$HOME/.config/fish"
  "$HOME/.config"
  "$HOME/.ssh"
  "$HOME/tmuxp"
  "$HOME/work"
  "$HOME/personal"
  "$HOME/buffer"
  "$HOME"
  "/mnt/c/Users/b.petrukovich/.config/wezterm"
  "$HOME/.local/scripts/multi-sessionizer-project/"
)

files=(
  "$HOME/.npmrc"
  "$HOME/.nuget/NuGet/NuGet.Config"
  "$HOME/.config/fish/config.fish"
  "$HOME/.aws/credentials"
  "$HOME/.local/scripts/multi-sessionizer"
  "$HOME/docker-services/docker-compose-work.yml"
  "$HOME/.tmux.conf"
)

get_dirs() {
  {
    if [ ${#project_dirs_depth_1[@]} -gt 0 ]; then
      find "${project_dirs_depth_1[@]}" \
        -mindepth 1 -maxdepth 1 \
        -type d \
        -not -path '*/.*' 2>/dev/null
    fi

    if [ ${#project_dirs_depth_2[@]} -gt 0 ]; then
      find "${project_dirs_depth_2[@]}" \
        -mindepth 1 -maxdepth 2 \
        -type d \
        -not -path '*/.*' 2>/dev/null
    fi

    printf '%s\n' "${extra_dirs[@]}"
  }
}

get_files() {
  [[ ${#files[@]} -eq 0 ]] && return
  printf '%s\n' "${files[@]}"
}

get_dirs_with_zoxide() {
  local dirs zoxide_scores score dir

  dirs=$(get_dirs)
  zoxide_scores=$(zoxide query -l 2>/dev/null)

  declare -A z_map
  while IFS= read -r line; do
    score="${line%% *}"
    dir="${line#* }"
    z_map["$dir"]="$score"
  done <<< "$zoxide_scores"

  while IFS= read -r dir; do
    [[ -z "$dir" ]] && continue
    printf '%s\t%s\n' "${z_map[$dir]:-0}" "$dir"
  done <<< "$dirs" | sort -rnk1 | cut -f2-
}

# =========================
# TMUX HANDLING
# =========================

process_selected_dirs() {
  local selected_dirs="$1"
  local tmux_running
  tmux_running=$(pgrep tmux)

  local count
  count=$(echo "$selected_dirs" | wc -l)

  if [[ "$count" -eq 1 ]]; then
    local dir name
    dir="$selected_dirs"
    name=$(basename "$dir" | tr . _)

    zoxide add "$dir"

    tmux has-session -t="$name" 2>/dev/null \
      || tmux new-session -ds "$name" -c "$dir"

    if [[ -z "$TMUX" ]]; then
      tmux attach -t "$name"
    else
      tmux switch-client -t "$name"
      tmux refresh-client -S
    fi
    exit 0
  fi

  while IFS= read -r dir; do
    [[ -z "$dir" ]] && continue
    local name
    name=$(basename "$dir" | tr . _)

    zoxide add "$dir"
    tmux has-session -t="$name" 2>/dev/null \
      || tmux new-session -ds "$name" -c "$dir"
  done <<< "$selected_dirs"

  if [[ -z "$TMUX" && -z "$tmux_running" ]]; then
    local first
    first=$(basename "$(echo "$selected_dirs" | head -n1)" | tr . _)
    tmux attach -t "$first"
  elif [[ -n "$TMUX" ]]; then
    tmux choose-session
    tmux refresh-client -S
  else
    tmux attach
  fi
}

process_selected_files() {
  local selected_files="$1"
  local tmux_running
  tmux_running=$(pgrep tmux)

  local count
  count=$(echo "$selected_files" | wc -l)

  if [[ "$count" -eq 1 ]]; then
    local filepath dir name
    filepath="$selected_files"
    dir="$(dirname "$filepath")"
    name=$(basename "$dir" | tr . _)

    zoxide add "$dir"

    tmux has-session -t="$name" 2>/dev/null \
      || tmux new-session -ds "$name" -c "$dir"

    tmux send-keys -t "$name" "nvim '$filepath'" Enter

    if [[ -z "$TMUX" ]]; then
      tmux attach -t "$name"
    else
      tmux switch-client -t "$name"
      tmux refresh-client -S
    fi
    exit 0
  fi

  while IFS= read -r filepath; do
    [[ -z "$filepath" ]] && continue
    local dir name
    dir="$(dirname "$filepath")"
    name=$(basename "$dir" | tr . _)

    zoxide add "$dir"
    tmux has-session -t="$name" 2>/dev/null \
      || tmux new-session -ds "$name" -c "$dir"
    tmux send-keys -t "$name" "nvim '$filepath'" Enter
  done <<< "$selected_files"

  if [[ -z "$TMUX" && -z "$tmux_running" ]]; then
    local first
    first=$(basename "$(dirname "$(echo "$selected_files" | head -n1)")" | tr . _)
    tmux attach -t "$first"
  elif [[ -n "$TMUX" ]]; then
    tmux choose-session
    tmux refresh-client -S
  else
    tmux attach
  fi
}

# =========================
# MAIN
# =========================

main() {
  # ---------- NON-INTERACTIVE MODE ----------
  if [[ $# -gt 0 ]]; then
    local resolved_dirs=()
    local resolved_files=()

    for arg in "$@"; do
      if [[ -d "$arg" ]]; then
        resolved_dirs+=("$(realpath "$arg")")
      elif [[ -f "$arg" ]]; then
        resolved_files+=("$(realpath "$arg")")
      else
        echo "Not a directory or file: $arg" >&2
        exit 1
      fi
    done

    if [[ ${#resolved_dirs[@]} -gt 0 ]]; then
      process_selected_dirs "$(printf "%s\n" "${resolved_dirs[@]}")"
    fi

    if [[ ${#resolved_files[@]} -gt 0 ]]; then
      process_selected_files "$(printf "%s\n" "${resolved_files[@]}")"
    fi

    exit 0
  fi

  local missing_files=()
  for f in "${files[@]}"; do
    [[ -e "$f" ]] || missing_files+=("$f")
  done
  if [[ ${#missing_files[@]} -gt 0 ]]; then
    printf 'The following files do not exist:\n' >&2
    printf '  %s\n' "${missing_files[@]}" >&2
    exit 1
  fi

  local missing_dirs=()
  for d in "${project_dirs_depth_1[@]}" "${project_dirs_depth_2[@]}" "${extra_dirs[@]}"; do
    [[ -d "$d" ]] || missing_dirs+=("$d")
  done
  if [[ ${#missing_dirs[@]} -gt 0 ]]; then
    printf 'The following directories do not exist:\n' >&2
    printf '  %s\n' "${missing_dirs[@]}" >&2
    exit 1
  fi

  local selected
  selected=$( {
    get_dirs_with_zoxide
    get_files
  } | fzf \
    --tmux \
    --multi \
    --prompt "Project > "
  )

  [[ -z "$selected" ]] && exit 0

  local dirs=()
  local files=()

  while IFS= read -r path; do
    [[ -z "$path" ]] && continue
    if [[ -f "$path" ]]; then
      files+=("$path")
    else
      dirs+=("$path")
    fi
  done <<< "$selected"

  if [[ ${#dirs[@]} -gt 0 ]]; then
    process_selected_dirs "$(printf "%s\n" "${dirs[@]}")"
  fi

  if [[ ${#files[@]} -gt 0 ]]; then
    process_selected_files "$(printf "%s\n" "${files[@]}")"
  fi
}

# =========================
# ENTRYPOINT
# =========================

main "$@"
